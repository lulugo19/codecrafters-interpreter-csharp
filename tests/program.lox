// This program uses for loops and block scopes<|SPACE|>// to print the updates to the same variable
var bar = "after";
{
  var bar = "before";

  for (var bar = 0; bar < 1; bar = bar + 1) {
    print bar;
    var bar = -1;
    print bar;
  }
}

{
  for (var bar = 0; bar > 0; bar = bar + 1) {}

  var bar = "after";
  print bar;

  for (bar = 0; bar < 1; bar = bar + 1) {
    print bar;
  }
}